    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "3.4.18"
  }
}
