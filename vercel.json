{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source":"/embed/:path*","headers":[{"key":"Content-Security-Policy","value":"frame-ancestors 'self' https://notion.so https://*.notion.so https://*.notion.site"}]}
  ]
}
